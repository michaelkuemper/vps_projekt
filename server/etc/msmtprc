# /etc/msmtprc - Mailversand der PSA-Zentrale ueber Strato (Repo vps_projekt)
# Das Passwort steht NICHT hier, sondern in /etc/msmtp-strato.passwort (root:psa 640)
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
syslog         LOG_MAIL

account        strato
host           smtp.strato.de
port           465
tls_starttls   off
user           psa@kuelib.de
from           psa@kuelib.de
passwordeval   "cat /etc/msmtp-strato.passwort"

account default : strato
